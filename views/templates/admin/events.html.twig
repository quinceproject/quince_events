{% extends '@Modules/quince_events/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_events/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quinceevents.Admin' %}

{% block quince_intro %}
    <div class="qc-alert qc-alert-info" style="margin-bottom:20px">
        {{ icons.icon('info', 18, 'qc-alert-icon') }}
        <div>{{ 'Everything the shop has sent to the outside world, and everything still waiting to go.'|trans }}</div>
    </div>
{% endblock %}

{% block quince_body %}
<div class="qc-stack">

    <div style="display:flex; gap:16px; flex-wrap:wrap">
        <div class="qc-card" style="flex:1; min-width:160px">
            <div class="qc-card-body">
                <div class="qc-muted" style="margin-bottom:4px">{{ 'Waiting to send'|trans }}</div>
                <div class="qc-stat">{{ counts.pending }}</div>
            </div>
        </div>
        <div class="qc-card" style="flex:1; min-width:160px">
            <div class="qc-card-body">
                <div class="qc-muted" style="margin-bottom:4px">{{ 'Delivered'|trans }}</div>
                <div class="qc-stat">{{ counts.sent }}</div>
            </div>
        </div>
        <div class="qc-card" style="flex:1; min-width:160px">
            <div class="qc-card-body">
                <div class="qc-muted" style="margin-bottom:4px">{{ 'Failed'|trans }}</div>
                <div class="qc-stat"{{ counts.failed > 0 ? ' style="color:var(--danger)"' }}>{{ counts.failed }}</div>
            </div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-body">
            <form method="get" action="{{ path('quince_events') }}" style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end">
                <div class="qc-field" style="max-inline-size:220px">
                    <label class="qc-label" for="q-type">{{ 'Event type'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select id="q-type" name="type" class="qc-field-base qc-select qc-focusable">
                            <option value=""{{ filters.type == '' ? ' selected' }}>{{ 'All'|trans }}</option>
                            {% for value in ['withdrawal.submitted', 'withdrawal.acknowledged', 'withdrawal.accepted', 'withdrawal.rejected', 'withdrawal.settled', 'order_return.created', 'order_return.status_changed', 'quince.test'] %}
                                <option value="{{ value }}"{{ filters.type == value ? ' selected' }}>{{ value }}</option>
                            {% endfor %}
                        </select>
                        {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                    </div>
                </div>
                <div class="qc-field" style="max-inline-size:180px">
                    <label class="qc-label" for="q-status">{{ 'Status'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select id="q-status" name="status" class="qc-field-base qc-select qc-focusable">
                            <option value=""{{ filters.status == '' ? ' selected' }}>{{ 'All'|trans }}</option>
                            <option value="pending"{{ filters.status == 'pending' ? ' selected' }}>{{ 'Waiting'|trans }}</option>
                            <option value="sent"{{ filters.status == 'sent' ? ' selected' }}>{{ 'Delivered'|trans }}</option>
                            <option value="failed"{{ filters.status == 'failed' ? ' selected' }}>{{ 'Failed'|trans }}</option>
                        </select>
                        {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                    </div>
                </div>
                <div class="qc-field" style="max-inline-size:160px">
                    <label class="qc-label" for="q-from">{{ 'From'|trans }}</label>
                    <input type="date" class="qc-field-base qc-focusable" id="q-from" name="from" value="{{ filters.from }}">
                </div>
                <div class="qc-field" style="max-inline-size:160px">
                    <label class="qc-label" for="q-to">{{ 'To'|trans }}</label>
                    <input type="date" class="qc-field-base qc-focusable" id="q-to" name="to" value="{{ filters.to }}">
                </div>
                <button type="submit" class="qc-btn qc-btn-outline">
                    {{ icons.icon('search', 14) }} {{ 'Filter'|trans }}
                </button>
                <a href="{{ path('quince_events') }}" class="qc-btn qc-btn-text">{{ 'Clear'|trans }}</a>
            </form>
        </div>
    </div>

    <div class="qc-table-wrap">
        {% if events %}
            <table class="qc-table">
                <thead>
                    <tr>
                        <th>{{ 'Type'|trans }}</th>
                        <th>{{ 'Submitted'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Attempts'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% set badge = { 'pending': 'qc-badge-warning', 'sent': 'qc-badge-success', 'failed': 'qc-badge-danger' } %}
                    {% set label = { 'pending': 'Waiting'|trans, 'sent': 'Delivered'|trans, 'failed': 'Failed'|trans } %}
                    {% for e in events %}
                        <tr>
                            <td><code>{{ e.type }}</code></td>
                            <td>{{ e.date_add }}</td>
                            <td><span class="qc-badge {{ badge[e.status] }}">{{ label[e.status] }}</span></td>
                            <td>{{ e.attempts }}</td>
                            <td>
                                <div class="qc-row-actions">
                                    <a href="{{ path('quince_events_event', {id: e.id_quince_event}) }}" class="qc-btn qc-btn-sm qc-btn-outline">{{ 'Details'|trans }}</a>
                                    {% if e.status == 'failed' %}
                                        <form method="post" action="{{ path('quince_events_event_retry', {id: e.id_quince_event}) }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_events_event_retry') }}">
                                            <button type="submit" class="qc-btn qc-btn-sm qc-btn-primary">{{ 'Retry'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="qc-table-foot">
                <span class="qc-muted">{{ 'Page %page% of %pages%, %total% entries'|trans({'%page%': page, '%pages%': pages, '%total%': total}) }}</span>
                {% if pages > 1 %}
                    <div class="qc-pagination">
                        {% if page > 1 %}
                            <a class="qc-page-btn" href="{{ path('quince_events', filters|merge({page: page - 1})) }}">‹</a>
                        {% endif %}

                        {% for numer in max(1, page - 2)..min(pages, page + 2) %}
                            <a class="qc-page-btn{{ numer == page ? ' qc-active' : '' }}"
                               href="{{ path('quince_events', filters|merge({page: numer})) }}">{{ numer }}</a>
                        {% endfor %}

                        {% if page < pages %}
                            <a class="qc-page-btn" href="{{ path('quince_events', filters|merge({page: page + 1})) }}">›</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="qc-empty">
                {{ icons.icon('file', 36, 'qc-empty-icon') }}
                <div class="qc-empty-text">{{ 'Nothing matches these filters.'|trans }}</div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
